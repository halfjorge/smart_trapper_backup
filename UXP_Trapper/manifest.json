{
  "id": "com.smarttrapper.uxp",
  "name": "Smart Trapper UXP",
  "version": "0.1.0",
  "manifestVersion": 5,
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "smart-trapper-panel",
      "label": {
        "default": "Smart Trapper"
      },
      "minimumSize": {
        "width": 320,
        "height": 560
      },
      "maximumSize": {
        "width": 900,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 760
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  }
}
